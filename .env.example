# Local Supabase Postgres (default from `supabase start`)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_BONUS_WINDOW_SECONDS=30

# Anti-cheat controls
ANTI_CHEAT_ENABLED=true
ANTI_CHEAT_MIN_GAME_DURATION_MS=55000
ANTI_CHEAT_SESSION_TTL_MS=120000
