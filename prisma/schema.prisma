generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model GameResult {
    id         String   @id @default(cuid())
    playerName String   @db.VarChar(80)
    score      Int
    misses     Int
    createdAt  DateTime @default(now())

    @@index([createdAt])
    @@map("game_results")
}
