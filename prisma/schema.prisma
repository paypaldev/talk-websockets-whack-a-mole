generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model GameResult {
    id                     String   @id @default(cuid())
    playerName             String   @db.VarChar(80)
    score                  Int
    misses                 Int
    disqualified           Boolean  @default(false)
    disqualificationReason String?  @db.VarChar(500)
    createdAt              DateTime @default(now())

    @@index([createdAt])
    @@map("game_results")
}

model SwagOrder {
    id            String   @id @default(cuid())
    itemId        String   @db.VarChar(120)
    playerName    String   @db.VarChar(80)
    paypalOrderId String?  @unique @db.VarChar(191)
    amountCents   Int
    currency      String   @db.VarChar(3)
    status        String   @default("pending") @db.VarChar(20)
    createdAt     DateTime @default(now())

    @@index([createdAt])
    @@map("swag_orders")
}

model GameSession {
    id               String    @id @default(cuid())
    playerName       String    @db.VarChar(80)
    sessionTokenHash String    @db.VarChar(64)
    createdAt        DateTime  @default(now())
    expiresAt        DateTime
    consumedAt       DateTime?

    @@index([createdAt])
    @@index([expiresAt])
    @@map("game_sessions")
}

model DisqualifiedName {
    id        String   @id @default(cuid())
    name      String   @db.VarChar(80)
    reason    String?  @db.VarChar(200)
    createdAt DateTime @default(now())

    @@index([createdAt])
    @@map("disqualified_names")
}
